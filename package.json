{
  "name": "timepostman",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TimePostman: photo/video date metadata correction for HarmonyOS gallery",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "app": "node app/server.mjs",
    "start": "node scripts/start-all.mjs",
    "start:all": "node scripts/start-all.mjs",
    "phone:transfer": "node phone-transfer/server.mjs",
    "verify:doctor": "node scripts/verify.mjs doctor",
    "verify:generate": "node scripts/verify.mjs generate",
    "verify:prepare": "node scripts/verify.mjs prepare",
    "verify:inspect": "node scripts/verify.mjs inspect",
    "verify:real": "node scripts/verify.mjs prepare --input samples/real && node scripts/verify.mjs inspect",
    "verify:all": "node scripts/verify.mjs all",
    "release": "node scripts/build-release.mjs"
  },
  "dependencies": {
    "exiftool-vendored": "^39.0.1",
    "express": "^5.3.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0"
  }
}
