// 复制本文件为 build-profile.json5，然后在 DevEco Studio 中生成自动签名，
// 或自行添加 signingConfigs 并在 products.default 中引用。
// 不要提交包含证书路径和密码的 build-profile.json5。
{
  "app": {
    "products": [
      {
        "name": "default",
        "compatibleSdkVersion": "6.0.2(22)",
        "runtimeOS": "HarmonyOS",
        "targetSdkVersion": "6.0.2(22)"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
